{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "share": "disabled",
  "formatter": true,
  "lsp": true,
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high",
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium",
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "variant": "high",
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
    },
    "compaction": {
      "model": "openai/gpt-5.6-terra",
    },
  },
  "permission": {
    "read": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "edit": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "bash": {
      "rm *": "ask",
      "rm *.env*": "deny",
      "git push*": "ask",
      "git add*": "ask",
      "git stage*": "ask",
      "git commit*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git cherry-pick*": "ask",
      "git revert*": "ask",
      "git am*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
    },
  },
}
